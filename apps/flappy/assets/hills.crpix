# Distant hills, the back parallax band.
#
# Tiles horizontally: every column of the last row is filled and the two bumps
# stop well short of both edges, so tile `i` and tile `i + 1` join on a flat
# horizon with no seam to line up.
#
# The silhouette is one texel of `t` along the top of each column and `h`
# below it, which draws the ridge line for free — no second sprite and no
# outline pass.
crpix: 64 24 1 4 1

palette:
  . c None
  t c #6fa87a
  h c #4c7d5c
  s c #3a6349

frame hills:
  ................................................................
  ................................................................
  ................................................................
  ................tt..............................................
