# The markers: what the navball-lite and the map put on top of themselves.
#
# Small and square, drawn `art::TEXEL_PX` pixels to the texel, every frame
# found **by name** in `src/art.rs`, so the order here is the author's to change
# and a renamed frame is a test failure rather than a marker drawn as another.
#
# * `prograde` and `retrograde` ride the navball's rim at the angle the
#   velocity makes with the local vertical — KSP's two symbols, cut down to
#   what a frame this small can hold: a ring with a centre and three spokes, and a
#   ring with a cross in it.
# * `heading` rides the same rim at the angle the engine points, in the yellow
#   KSP draws its own ship reference in.
# * `apoapsis` and `periapsis` sit on the map at the orbit's two apsides: a
#   triangle pointing up for the high point and down for the low one, so the
#   pair reads apart by shape before it reads apart by colour.
# * `ship` is where the rocket is on the map.
#
# Every stroke has a dark outline round it, because the same marker is drawn
# over sky, ground, space and the trajectory's own blue.
#
# **Placeholder art, written as text.** No artist drew these: they are text in
# this file, which is the source `build.rs` bakes, so what a reviewer reads is
# the picture that loads.
crpix: 13 13 6 7 1

palette:
  . c None
  k c #0b0d14
  g c #b6f06a
  y c #ffd75e
  a c #8fd0ff
  p c #ffa64d
  w c #fff8dd

frame prograde:
  ......k......
  .....kgk.....
  .....kgk.....
  ....kgggk....
  ...kgkkkgk...
  .kkgk.k.kgkk.
  kgggkkgkkgggk
  .kkgk.k.kgkk.
  ...kgkkkgk...
  ....kgggk....
  .....kkk.....
  .............
  .............

frame retrograde:
  ......k......
  .....kgk.....
  .....kgk.....
  ....kgggk....
  ...kgkkkgk...
  ..kgkgkgkgk..
  ..kgkkgkkgk..
  ..kgkgkgkgk..
  ...kgkkkgk...
  ..k.kgggk.k..
  .kgk.kkk.kgk.
  ..k.......k..
  .............

frame heading:
  .............
  .............
  ......k......
  .....kyk.....
  .....kyk.....
  .....kkk.....
  ....kyyyk....
  .kkkykkkykkk.
  kyyyk...kyyyk
  .kkk.....kkk.
  .............
  .............
  .............

frame apoapsis:
  .............
  ......k......
  .....kak.....
  ....kakak....
  ....kakak....
  ...kak.kak...
  ...kak.kak...
  ..kak...kak..
  ..kakkkkkak..
  .kaaaaaaaaak.
  ..kkkkkkkkk..
  .............
  .............

frame periapsis:
  .............
  .............
  ..kkkkkkkkk..
  .kpppppppppk.
  ..kpkkkkkpk..
  ..kpk...kpk..
  ...kpk.kpk...
  ...kpk.kpk...
  ....kpkpk....
  ....kpkpk....
  .....kpk.....
  ......k......
  .............

frame ship:
  .............
  .............
  ......k......
  .....kwk.....
  ....kwkwk....
  ...kwkkkwk...
  ..kwkkwkkwk..
  ...kwkkkwk...
  ....kwkwk....
  .....kwk.....
  ......k......
  .............
  .............

sample: pixel
