# Normalize line endings for text files; Git decides what is text.
* text=auto

# Content-hashed sources: LF everywhere, on every platform.
#
# `crates/crcbl-shaders` records a SHA-256 of each shader source so a build
# with no compiler can still tell that the committed SPIR-V matches what it was
# built from. `text=auto` above would hand a Windows checkout CRLF, changing
# those bytes and failing the check on a file nobody edited — which is exactly
# what happened on the first Windows run after the manifest landed. Anything
# whose *bytes* are part of a checked invariant belongs here.
*.slang text eol=lf

# Shell harnesses: LF regardless of platform, since they run under bash.
*.sh text eol=lf

# Binary assets: never diffed or line-ending-mangled as text.
*.png  binary
*.ktx2 binary
*.bin  binary
*.gltf binary
*.glb  binary
*.wav  binary
*.qoa  binary
*.spv  binary

# Git LFS is deliberately NOT enabled yet. Everything binary through P8 is small
# (golden images are a few KB and get re-blessed often, which LFS handles worse
# than plain Git), and an `filter=lfs` line breaks `git commit` outright on any
# clone without the git-lfs binary installed. LFS turns on when the P9 glTF
# corpus lands — and when it does, every `actions/checkout` step in CI must gain
# `lfs: true` in the same commit, or CI silently tests against pointer files.
#
#   *.glb filter=lfs diff=lfs merge=lfs -text
