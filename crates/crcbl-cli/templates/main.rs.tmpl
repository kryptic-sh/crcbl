//! `{{name}}` — a Crucible game.
//!
//! ```text
//! cargo run                             # open a window
//! cargo run -- --headless --frames 60   # no window, terminates, CI-friendly
//! ```
//!
//! # The engine owns the frame
//!
//! Pumping the shell, routing input, running the fixed-timestep ticks the clock
//! owes, laying out the pause menu, drawing the debug overlay, presenting, and
//! tearing all of it down in the right order is [`crcbl::engine::Loop`]. What is
//! left for a game is the two halves below:
//!
//! * [`Game`] — the simulation, the input it cares about, and its HUD. Ten
//!   methods, most of them one line.
//! * [`Gpu`] — this game's renderers and the render graph that joins them, on
//!   top of [`crcbl::engine::GpuContext`], which owns the instance, the adapter,
//!   the device, the surface, the swapchain and the frames-in-flight ring.
//!
//! Every sample in the engine checkout is these same two halves, larger:
//! `apps/breakout`, `apps/flappy`, `apps/asteroids`, `apps/horde`. Read one of
//! them next — a sprite sheet, a physics world and a score are all additions to
//! this shape, not departures from it.
//!
//! What arrives already working: `ESC` pauses and opens the menu, `F11` toggles
//! borderless fullscreen, `F3` toggles the debug panel, the mouse and the
//! keyboard both drive the menu, a resize reconfigures the swapchain, and
//! `--headless` runs the identical loop against a shell with no window system
//! behind it.
//!
//! # Taking the frame back is supported
//!
//! `apps/bare` in the engine checkout drives the same public pieces —
//! [`crcbl::engine::GpuContext`], `Pending`, `FrameBudget` — from a `loop {}` it
//! writes itself, and `crates/crcbl/tests/library_seam.rs` guards that path from
//! outside the crate. The hosted loop is the default, not the toll gate.

use core::convert::Infallible;
use std::process::ExitCode;

use crcbl::args::{COMMON_OPTIONS_HELP, COMMON_TAIL_HELP, Common, Consumed, Invocation};
use crcbl::core::input::KeyCode;
use crcbl::engine::{
    Booted, Clock, DEBUG_OVERLAY_ID, FRAMES_IN_FLIGHT, FULLSCREEN_ID, FrameInfo, FrameOutcome,
    GameGpu, GpuContext, GpuContextDesc, GpuError, GpuOptions, GpuSurface, HostedGame, LoopError,
    RESUME_ID, RunSummary, drive, open_window, wait_for_configure,
};
use crcbl::hal::{CommandEncoderDesc, Features};
use crcbl::math::Vec2;
use crcbl::prelude::*;
use crcbl::render::{
    FrameCounters, FrameTimings, MAX_TIMED_PASSES, MenuRenderer, PassTimers, TransientPool,
    UiRenderer,
};
use crcbl::shell::{LogicalSize, open, open_backend};
use crcbl::ui::WidgetId;
use crcbl::ui::draw_list::DrawList;
use crcbl::ui::menu::{Menu, MenuItem, MenuLayout, MenuSet};
use crcbl::ui::text::FontAtlas;

/// This game's name: window title, log prefix, and the line a finished run
/// prints.
const NAME: &str = "{{name}}";

/// The id a window system keys this game's icon, its rules and its taskbar entry
/// on.
///
/// Compositors expect reverse-DNS and match it against a `.desktop` file, so a
/// real project replaces this with a domain it owns — the samples use
/// `sh.kryptic.crcbl.breakout` and the like. A bare name is legal and works;
/// what it costs is the icon.
const APP_ID: &str = "{{name}}";

/// The simulation rate. Fixed, and independent of the frame rate.
///
/// The default the command line starts from — `--tick-hz` overrides it, and
/// [`crcbl::engine::LoopConfig::tick_hz`] is what actually drives the
/// accumulator.
const TICK_HZ: u32 = 60;

/// What the window asks the compositor for. A window system is free to refuse.
const WINDOW_SIZE: LogicalSize = LogicalSize::new(960.0, 720.0);

/// The colour the frame starts from, linear RGBA.
const BACKGROUND: [f32; 4] = [0.05, 0.06, 0.09, 1.0];

/// The colour of the one thing this game draws.
const ACCENT: [f32; 4] = [0.35, 0.75, 1.0, 1.0];

/// HUD text.
const TEXT: [f32; 4] = [0.85, 0.85, 0.9, 1.0];

/// The side of the box, in pixels.
const BOX_SIZE: f32 = 64.0;

/// How fast the box travels, in pixels per second of *simulated* time.
const BOX_SPEED: f64 = 240.0;

/// What can stop this game: the loop's own failures, plus the game's.
///
/// [`Infallible`] is the game half here because nothing in [`Game`] can fail
/// yet. Give it a real error type and this alias is the only line that changes.
type Error = LoopError<Infallible>;

// ---- the game ---------------------------------------------------------------

/// The game, as the engine's loop hosts it.
#[derive(Debug, Default)]
struct Game {
    /// Simulated seconds. Advanced by [`HostedGame::tick`] and by nothing else,
    /// so it stops while the loop is paused and is identical on every machine in
    /// a headless run.
    elapsed: f64,
    /// The last key the menu did not claim.
    last_key: Option<KeyCode>,
    /// The status line, rebuilt only when what it says changes.
    ///
    /// `format!` in [`HostedGame::draw`] would allocate at whatever rate the
    /// window runs at — 144 times a second on a fast display, to print a number
    /// that changes once. [`Game::status_key`] is what it was last built for.
    status: String,
    status_key: Option<(u64, bool, Option<KeyCode>)>,
}

impl HostedGame for Game {
    type Error = Infallible;
    type Gpu = Gpu;
    /// Keyed by whether the loop is paused, because this game has exactly one
    /// menu. A game with a start screen and a game-over panel keys its set by an
    /// enum naming them instead.
    type MenuKind = bool;
    type MenuAction = Infallible;
    type Summary = RunSummary;

    const NAME: &'static str = NAME;

    fn menus() -> MenuSet<bool> {
        // `false` — the running game — has no entry, which is how the set is
        // told that a running frame draws no menu at all.
        MenuSet::new(
            false,
            vec![(
                true,
                Menu::new(
                    "PAUSED",
                    vec![
                        MenuItem::new(RESUME_ID, "RESUME", "ESC"),
                        MenuItem::new(FULLSCREEN_ID, "FULLSCREEN", "F11"),
                        MenuItem::new(DEBUG_OVERLAY_ID, "DEBUG PANEL", "F3"),
                    ],
                ),
            )],
        )
    }

    /// One fixed simulation step. Your game goes here.
    ///
    /// Called zero or more times per frame — zero on a frame that arrived early,
    /// more than one after a long frame — and never while paused. Anything
    /// stepped once per *frame* instead has a speed proportional to the frame
    /// rate, which is the bug this whole shape exists to prevent.
    fn tick(&mut self, _gpu: &mut Gpu, tick_dt: f64) {
        self.elapsed += tick_dt;
    }

    /// A key the menu did not claim.
    ///
    /// `ESC`, `F11`, `F3` and the menu's own navigation never reach here: the
    /// loop acts on those itself. Everything else does.
    fn key_event(&mut self, key: KeyCode, pressed: bool) {
        if pressed {
            self.last_key = Some(key);
        }
    }

    /// The game action a widget id names.
    ///
    /// This game's menu is the loop's three buttons and nothing else, so there
    /// is no id left to answer about. Add a button whose id is at or above
    /// [`crcbl::engine::FIRST_GAME_ID`] and this is where it becomes an action.
    fn menu_action(_id: WidgetId) -> Option<Infallible> {
        None
    }

    /// Does what a fired menu button of this game's asks for.
    ///
    /// [`Infallible`] is uninhabited, so [`Self::menu_action`] can never hand
    /// one over and there is nothing to match — which is the type system saying
    /// "this game's menus do nothing only this game can do". A real action type
    /// turns this into an ordinary `match`.
    fn apply(&mut self, action: Infallible) {
        match action {}
    }

    fn menu_kind(&mut self, _menus: &mut MenuSet<bool>, paused: bool) -> bool {
        paused
    }

    /// Hands this frame's state to the GPU and appends this game's UI geometry.
    ///
    /// The draw list is in pixels and is cleared before this is called; the menu
    /// and the debug overlay are appended to the same list afterwards, which is
    /// why the scrim dims the HUD and the overlay stays legible on top of both.
    fn draw(&mut self, gpu: &mut Gpu, draw_list: &mut DrawList, frame: FrameInfo) {
        let (width, height) = gpu.extent();

        // A box tracking back and forth across the window: a triangle wave, so
        // there is no direction to store. `span` is zero on a surface narrower
        // than the box, and `rem_euclid(0.0)` is NaN — hence the branch.
        let span = f64::from(width) - f64::from(BOX_SIZE);
        let x = if span > 0.0 {
            let phase = (self.elapsed * BOX_SPEED).rem_euclid(2.0 * span);
            let along = if phase > span {
                2.0 * span - phase
            } else {
                phase
            };
            along as f32
        } else {
            0.0
        };
        let y = (height as f32 - BOX_SIZE) * 0.5;
        draw_list.rect(
            Vec2::new(x, y),
            Vec2::new(x + BOX_SIZE, y + BOX_SIZE),
            ACCENT,
        );

        self.refresh_status(frame.paused);
        draw_list.text(Vec2::new(12.0, 12.0), self.status.as_str(), TEXT, 16.0);
        draw_list.text(
            Vec2::new(12.0, 34.0),
            "ESC menu   F11 fullscreen   F3 debug panel",
            TEXT,
            14.0,
        );
    }

    /// Adds this game's own fields to the run's shared ones.
    ///
    /// [`RunSummary`] unchanged, because this game has no score, no level and no
    /// time survived to add. A game that does declares a struct of its own and
    /// builds it from `run` here.
    fn summary(&self, run: RunSummary) -> RunSummary {
        run
    }

    fn log_summary(summary: &RunSummary) {
        crcbl::log::info!(
            "{NAME}: {} frames, {} ticks ({:?})",
            summary.frames,
            summary.ticks,
            summary.exit,
        );
    }
}

impl Game {
    /// Rebuilds [`Game::status`] when, and only when, what it would say has
    /// changed.
    fn refresh_status(&mut self, paused: bool) {
        let key = (self.elapsed as u64, paused, self.last_key);
        if self.status_key == Some(key) {
            return;
        }
        self.status_key = Some(key);

        use std::fmt::Write as _;
        self.status.clear();
        let _ = write!(
            self.status,
            "{}s  {}  last key: {}",
            key.0,
            if paused { "PAUSED" } else { "running" },
            match self.last_key {
                Some(code) => format!("{code:?}"),
                None => "none".to_string(),
            },
        );
    }
}

// ---- the gpu ----------------------------------------------------------------

/// This game's renderers, and the context they draw through.
///
/// Everything that is not this game's — opening a backend, choosing an adapter
/// that can actually present, the swapchain, the frames-in-flight ring, resize
/// and teardown — is [`GpuContext`]. What is left here is which passes run and
/// in what order.
#[derive(Debug)]
struct Gpu {
    ctx: GpuContext,
    /// Images and buffers the render graph asks for, reused across frames.
    pool: TransientPool,
    /// `None` on a device without timestamp queries, which is not an error:
    /// the debug panel simply reports no per-pass times.
    timers: Option<PassTimers>,
    /// The pause menu's own pass: its skin, its own screen-space camera, and a
    /// pass that declares nothing on a frame with no menu on it.
    menu: MenuRenderer,
    /// The 2D compositor every draw list goes through.
    ui: UiRenderer,
    atlas: FontAtlas,
    draw_list: DrawList,
}

impl Gpu {
    /// Opens a backend, a surface, a device and a swapchain, and builds the
    /// renderers on top of them.
    ///
    /// # Errors
    ///
    /// [`GpuError`] if no backend opened or a renderer refused the device.
    fn open<S: Shell + ?Sized>(
        shell: &S,
        window: WindowId,
        extent: (u32, u32),
        gpu: GpuOptions,
    ) -> Result<Self, GpuError> {
        let ctx = GpuContext::open(
            shell,
            window,
            extent,
            &GpuContextDesc {
                label: NAME,
                // Optional, never required: the UI pass hands its shader the
                // viewport size through a push constant where there are any and
                // through a uniform buffer where there are none. A browser is
                // always the second case — WebGPU has no push constants at all.
                optional_features: Features::GPU_DRIVEN
                    | Features::TIMESTAMP_QUERY
                    | Features::DEBUG_MARKERS
                    | Features::PUSH_CONSTANTS,
                // The command line's half: `--backend` and `--pacing`. The
                // label and the features above are this game's.
                ..GpuContextDesc::from(gpu)
            },
        )?;

        let format = ctx.format();
        let timers = PassTimers::new(ctx.device(), FRAMES_IN_FLIGHT, MAX_TIMED_PASSES);
        let menu = MenuRenderer::new(ctx.device(), ctx.queue(), format).map_err(GpuError::Hal)?;
        // Hand-unwound rather than `?`: a renderer that failed after an earlier
        // one succeeded leaves that one holding device objects, and dropping it
        // does not release them.
        let ui = match UiRenderer::new(ctx.device(), ctx.queue(), format) {
            Ok(ui) => ui,
            Err(error) => {
                menu.destroy(ctx.device());
                return Err(GpuError::Hal(error));
            }
        };

        Ok(Self {
            ctx,
            pool: TransientPool::new(),
            timers,
            menu,
            ui,
            atlas: FontAtlas::built_in(),
            draw_list: DrawList::new(),
        })
    }

    /// Records, submits and presents one frame.
    ///
    /// # Errors
    ///
    /// [`GpuError`] for anything except a swapchain that has merely gone out of
    /// date, which is reported as [`FrameOutcome::Reconfigured`].
    fn frame(&mut self) -> Result<FrameOutcome, GpuError> {
        let Some(acquired) = self.ctx.acquire()? else {
            return Ok(FrameOutcome::Reconfigured);
        };
        // The swapchain's extent, not the one the resize event reported: on the
        // frame a reconfigure lands the two can differ, and every pass has to
        // agree with the surface actually being drawn into.
        let extent = acquired.extent;

        self.menu
            .begin_frame(self.ctx.device(), extent)
            .map_err(GpuError::Hal)?;
        self.ui
            .begin_frame(self.ctx.device(), &self.draw_list, &self.atlas, 1.0)
            .map_err(GpuError::Hal)?;

        let format = self.ctx.format();
        let compiled = {
            // **Pass order is declaration order.** The clear is the only pass
            // that does not load what is already in the target, so it goes
            // first; the menu's scrim dims what the game drew, so it goes after
            // it; the UI's text is drawn last or the frame paints over its own
            // words.
            let mut graph = RenderGraph::new(self.ctx.queue());
            let target = graph.import_image(
                "swapchain",
                ForwardRenderer::present_target(acquired.image, acquired.view, format, extent),
            );
            graph
                .add_render_pass("background")
                .clear_color(target, BACKGROUND)
                .execute(|_| {});
            self.menu.add_pass(&mut graph, target);
            self.ui.add_pass(&mut graph, target, extent);
            graph.compile(&self.pool)?
        };

        let mut encoder = self
            .ctx
            .device()
            .create_command_encoder(&CommandEncoderDesc {
                label: Some("{{name}} frame"),
                queue: self.ctx.queue(),
            });
        compiled.execute(
            self.ctx.device(),
            &mut self.pool,
            encoder.as_mut(),
            self.timers.as_mut(),
        )?;
        let command_buffer = encoder.finish()?;

        let outcome = self.ctx.submit_and_present(&acquired, command_buffer)?;
        // Only after the submit has retired, so nothing the pool releases can
        // still be referenced by a submission that has not completed.
        self.pool.retire_unused(self.ctx.device());
        Ok(outcome)
    }
}

/// The frame's half of this bundle, for [`crcbl::engine::Loop`].
impl GameGpu for Gpu {
    fn atlas(&self) -> &FontAtlas {
        &self.atlas
    }

    fn set_menu(&mut self, menu: Option<(&Menu, &MenuLayout)>) {
        self.menu.set_menu(menu);
    }

    /// Takes this frame's UI geometry, handing the previous frame's allocation
    /// back so the loop refills it instead of building a new one.
    fn take_draw_list(&mut self, list: &mut DrawList) {
        std::mem::swap(&mut self.draw_list, list);
    }

    fn timings(&self) -> Option<&FrameTimings> {
        self.timers.as_ref().map(PassTimers::latest)
    }

    /// What this frame drew, summed across every renderer the bundle owns.
    ///
    /// Each renderer answers for itself and `plus` adds them up, so a renderer
    /// added here has to be added to this sum too — a total that quietly omits
    /// one reads as a smaller frame rather than as a missing row.
    fn counters(&self) -> FrameCounters {
        self.menu.counters().plus(self.ui.counters())
    }

    fn frame(&mut self) -> Result<FrameOutcome, GpuError> {
        Self::frame(self)
    }

    /// Releases everything, in dependency order.
    ///
    /// Nothing may be destroyed while the device might still be using it, which
    /// is what [`GpuContext::drain`] waits for.
    fn destroy(mut self) -> Result<(), GpuError> {
        self.ctx.drain()?;
        self.ui.destroy(self.ctx.device());
        self.menu.destroy(self.ctx.device());
        self.pool.destroy(self.ctx.device());
        if let Some(timers) = self.timers.as_mut() {
            timers.destroy(self.ctx.device());
        }
        self.ctx.destroy()
    }
}

/// The two questions both halves of the engine ask a swapchain's owner.
impl GpuSurface for Gpu {
    fn extent(&self) -> (u32, u32) {
        self.ctx.extent()
    }

    fn resize(&mut self, extent: (u32, u32)) -> Result<(), GpuError> {
        self.ctx.resize(extent)
    }
}

// ---- start-up ---------------------------------------------------------------

/// Opens a shell, a window, a GPU and the game, and assembles the loop.
///
/// # Errors
///
/// [`Error`] if any of them refused.
fn start(options: &Common) -> Result<crcbl::engine::Loop<dyn Shell, Game>, Error> {
    // Headless is never selected automatically: a game that silently ran with no
    // window would look like a hang.
    let mut shell = if options.headless {
        open_backend(ShellBackend::Headless).map_err(Error::Shell)?
    } else {
        open().map_err(Error::NoWindowSystem)?
    };

    // A manual clock in a headless run, so its tick count is identical on every
    // machine — which is what makes it assertable in CI.
    let clock_source = Clock::new(options.headless);
    let window = open_window(
        shell.as_mut(),
        &clock_source,
        &WindowDesc {
            title: NAME,
            app_id: APP_ID,
            // `--size` names pixels; the window request is logical at scale 1,
            // which is exactly the extent the headless offscreen ring renders
            // at.
            size: options
                .size
                .map_or(WINDOW_SIZE, |size| size.to_logical(1.0)),
            // Asked for at creation rather than switched to afterwards, so
            // `--fullscreen` does not show a decorated window first.
            mode: options.display_mode(),
            ..WindowDesc::default()
        },
    )?;

    // A window has no size until the window system says so, and a swapchain
    // needs one. This wait is mandatory, not defensive.
    let mut events = 0;
    let extent = wait_for_configure(shell.as_mut(), window, &mut events)?;
    let gpu = Gpu::open(shell.as_ref(), window, extent, options.gpu())?;

    Ok(crcbl::engine::Loop::new(
        Booted {
            shell,
            window,
            gpu,
            clock_source,
            events,
        },
        Game::default(),
        // The tick rate, the frame budget, the overlay, whether to idle between
        // frames, and the `--fps` limit — every one of them straight off the
        // command line, so a flag added to `Common` reaches this loop without
        // this call changing.
        options.loop_config(),
    ))
}

/// The help text.
///
/// Assembled from the engine's own two blocks rather than written out, so it
/// cannot drift from what the flags actually do. A flag of this game's own is
/// described between them, which is where all four samples put theirs.
fn usage() -> String {
    format!(
        "{NAME} — a Crucible game\n\nUSAGE:\n    {NAME} [OPTIONS]\n\nOPTIONS:\n\
         {COMMON_OPTIONS_HELP}\n{COMMON_TAIL_HELP}"
    )
}

/// Parses argv into the shared options, and nothing else yet.
///
/// [`Common`] carries every flag the engine defines. A flag of this game's own
/// goes in the [`Consumed::No`] arm, which is where an unrecognised argument
/// currently ends up.
///
/// A game whose own defaults differ from the engine's writes them here, and the
/// command line still overrides them:
///
/// ```ignore
/// let mut options = Common {
///     // 144 rather than the engine's 1000, and vsync rather than "follow the
///     // display". `--fps` and `--pacing` still win over both.
///     limit: crcbl::engine::FrameLimit::fps(144),
///     pacing: crcbl::engine::Pacing::Vsync,
///     ..Common::new(TICK_HZ)
/// };
/// ```
///
/// Either can also be changed while the game is running — a settings screen
/// calls `crcbl::engine::GpuContext::set_pacing` on this game's own [`Gpu`] and
/// `crcbl::engine::Clock::set_limit` on the loop's clock.
fn parse(args: impl Iterator<Item = String>) -> Invocation<Common> {
    let mut options = Common::new(TICK_HZ);
    let mut rest = args;
    while let Some(arg) = rest.next() {
        match options.consume(&arg, &mut rest) {
            Consumed::Yes => {}
            Consumed::Help => return Invocation::Help,
            Consumed::Bad(message) => return Invocation::BadUsage(message),
            Consumed::No => {
                return Invocation::BadUsage(format!("unrecognized argument `{arg}`"));
            }
        }
    }
    Invocation::Run(options)
}

/// Exit codes: 0 ran, 1 it failed, 2 bad arguments.
fn main() -> ExitCode {
    crcbl::args::run_front_end(
        NAME,
        &usage(),
        parse(std::env::args().skip(1)),
        |options| start(options).and_then(drive),
        |summary| {
            // `summary.mode` is what the window system actually did, not
            // what `--fullscreen` asked for. A compositor is free to
            // refuse, and a line that echoed the request would hide it.
            format!(
                "{NAME}: {} frames, {} ticks on the {} shell at {}x{}, {} ({:?})",
                summary.frames,
                summary.ticks,
                summary.backend,
                summary.extent.0,
                summary.extent.1,
                summary.mode,
                summary.exit,
            )
        },
    )
}

// ---- tests ------------------------------------------------------------------

#[cfg(test)]
mod tests {
    use super::*;

    /// This game's whole menu vocabulary, which is the loop's three actions and
    /// nothing else — [`Infallible`] as the game half makes
    /// [`crcbl::engine::MenuAction::Game`] uninhabited, which is the type system
    /// saying "this game's menus do nothing only this game can do".
    type Action = crcbl::engine::MenuAction<Infallible>;

    /// Every button carries an action the loop can act on, and no two carry the
    /// same one.
    ///
    /// The failure this guards is a numbering bug: a button given an id below
    /// [`crcbl::engine::FIRST_GAME_ID`] would fire one of the loop's actions
    /// instead of its own, and the symptom is a button that un-pauses rather
    /// than doing what its label says.
    #[test]
    fn every_button_names_an_action_the_loop_handles() {
        let mut menus = Game::menus();
        menus.show(true);
        let menu = menus.current().expect("the pause menu");
        let actions: Vec<Action> = menu
            .items()
            .iter()
            .map(|item| {
                Action::from_id(item.id, Game::menu_action)
                    .unwrap_or_else(|| panic!("{} names no action", item.label))
            })
            .collect();
        assert_eq!(actions.len(), 3);
        for (index, action) in actions.iter().enumerate() {
            assert!(
                !actions[..index].contains(action),
                "the menu carries {action:?} twice",
            );
        }
    }

    /// A running frame shows no menu, and a paused one shows the pause menu.
    #[test]
    fn the_menu_is_shown_only_while_paused() {
        let mut game = Game::default();
        let mut menus = Game::menus();

        assert!(!game.menu_kind(&mut menus, false));
        menus.show(false);
        assert!(menus.current().is_none(), "a running frame drew a menu");

        assert!(game.menu_kind(&mut menus, true));
        menus.show(true);
        assert_eq!(menus.current().expect("the pause menu").title, "PAUSED");
    }

    /// A key press records the key and moves nothing else.
    ///
    /// [`HostedGame::tick`] is the only thing that may advance the simulation:
    /// input applied outside it runs at the frame rate rather than the tick
    /// rate. Calling `tick` here would need a real device, so this asserts the
    /// half a unit test can reach — that `key_event` took no shortcut.
    #[test]
    fn a_key_press_records_the_key_and_advances_nothing() {
        let mut game = Game::default();
        game.key_event(KeyCode::Space, true);
        assert_eq!(game.elapsed, 0.0, "a key press advanced the simulation");
        assert_eq!(game.last_key, Some(KeyCode::Space));
    }
}
